# Ubuntu 24.04 Production Environment Variables
# Copy this file to your Ubuntu server and update the values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DB=household_services
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_STRONG_DB_PASSWORD_HERE
POSTGRES_HOST_AUTH_METHOD=md5

# =============================================================================
# BACKEND API CONFIGURATION
# =============================================================================
NODE_ENV=production
DB_HOST=happyhomes_db_ubuntu
DB_PORT=5432
DB_NAME=household_services
DB_USER=postgres
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD_HERE
PORT=8001

# JWT Configuration - CHANGE THIS
JWT_SECRET=YOUR_SUPER_SECRET_JWT_KEY_FOR_UBUNTU_PRODUCTION_CHANGE_THIS

# CORS Origins - Update with your actual domain
ALLOWED_ORIGINS=https://happyhomesworld.com,https://www.happyhomesworld.com,http://localhost:3001

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
VITE_API_BASE_URL=/api
VITE_APP_NAME=Happy Homes
VITE_APP_VERSION=1.0.0
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_MAINTENANCE_MODE=false

# =============================================================================
# UBUNTU PRODUCTION SETTINGS
# =============================================================================
TZ=Asia/Kolkata
DEBIAN_FRONTEND=noninteractive

# PM2 Configuration
PM2_HOME=/app/.pm2
PM2_PUBLIC_KEY=
PM2_SECRET_KEY=

# Logging
LOG_LEVEL=info
LOG_FILE=/app/logs/app.log

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=YOUR_SESSION_SECRET_CHANGE_THIS
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=strict

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Node.js Memory Settings
NODE_OPTIONS="--max-old-space-size=1536"

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000

# =============================================================================
# MONITORING & HEALTH CHECKS
# =============================================================================
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5000

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/opt/happyhomes/backups

# =============================================================================
# DEPLOYMENT INFO
# =============================================================================
DEPLOYMENT_ENV=ubuntu-production
DEPLOYMENT_PLATFORM=linux/amd64
DEPLOYMENT_DATE=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
APP_VERSION=1.0.0