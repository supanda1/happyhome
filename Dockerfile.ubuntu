# Ubuntu 24.04 Production Frontend Dockerfile
# Platform: linux/amd64
# Multi-stage build optimized for Ubuntu server

FROM node:20-alpine AS builder
LABEL stage="builder"
LABEL platform="linux/amd64"

# Set platform
PLATFORM linux/amd64

# Ubuntu-specific build environment
ENV NPM_CONFIG_LOGLEVEL=warn \
    NPM_CONFIG_COLOR=false \
    DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Kolkata

# Install build dependencies
RUN apk add --no-cache \
    curl \
    wget \
    bash \
    git \
    python3 \
    make \
    g++ \
    tzdata \
    ca-certificates

# Set timezone
RUN cp /usr/share/zoneinfo/Asia/Kolkata /etc/localtime && \
    echo "Asia/Kolkata" > /etc/timezone

# Create app directory
WORKDIR /app

# Copy package files
COPY package.json ./
COPY tsconfig.json ./
COPY tsconfig.app.json ./
COPY tsconfig.node.json ./
COPY vite.config.ts ./
COPY postcss.config.js ./
COPY tailwind.config.js ./
COPY index.html ./

# Clean install for Ubuntu production build
RUN rm -rf node_modules package-lock.json || true && \
    sed -i '/"prepare":/d' package.json && \
    npm install --no-audit --no-fund && \
    npm cache clean --force

# Copy source code
COPY src/ ./src/
COPY public/ ./public/

# Ubuntu production build environment variables
ENV VITE_API_BASE_URL=/api \
    VITE_APP_NAME="Happy Homes" \
    VITE_APP_VERSION=1.0.0 \
    VITE_ENABLE_ANALYTICS=false \
    VITE_ENABLE_ERROR_REPORTING=true \
    VITE_ENABLE_MAINTENANCE_MODE=false \
    NODE_OPTIONS="--max-old-space-size=2048"

# Build application with Ubuntu optimizations
RUN npm run build && \
    ls -la dist/ && \
    du -sh dist/

# Production stage - Ubuntu optimized nginx
FROM nginx:1.24-alpine AS production
LABEL maintainer="Happy Homes Team"
LABEL platform="linux/amd64"
LABEL environment="ubuntu-production"

# Set platform
PLATFORM linux/amd64

# Install additional tools for Ubuntu deployment
RUN apk add --no-cache \
    curl \
    wget \
    bash \
    tzdata \
    ca-certificates \
    logrotate

# Set timezone
RUN cp /usr/share/zoneinfo/Asia/Kolkata /etc/localtime && \
    echo "Asia/Kolkata" > /etc/timezone

# Copy Ubuntu-specific nginx configuration
COPY nginx.ubuntu.conf /etc/nginx/conf.d/default.conf

# Remove default nginx config
RUN rm -f /etc/nginx/conf.d/default.conf.bak

# Copy built app from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Create nginx directories for Ubuntu
RUN mkdir -p /var/log/nginx /var/cache/nginx /var/run && \
    touch /var/run/nginx.pid

# Set proper permissions for Ubuntu deployment
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/log/nginx && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown nginx:nginx /var/run/nginx.pid && \
    chmod 644 /etc/nginx/conf.d/default.conf

# Create custom nginx user for Ubuntu security
RUN addgroup -g 101 -S nginx_ubuntu || true && \
    adduser -S nginx_ubuntu -u 101 -G nginx_ubuntu || true

# Expose port
EXPOSE 80

# Ubuntu-specific health check
HEALTHCHECK --interval=30s --timeout=15s --start-period=45s --retries=3 \
    CMD curl -f http://localhost:80/health || wget --no-verbose --tries=1 --spider http://localhost:80/health || exit 1

# Start nginx with Ubuntu optimizations
CMD ["nginx", "-g", "daemon off;"]